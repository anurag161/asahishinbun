{
  "name": "@asahi/server",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && node ../scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
