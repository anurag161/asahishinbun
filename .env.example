# Copy this file to `.env` (in the project root). Everything here is OPTIONAL —
# with none of it set, the app runs the zero-setup in-memory demo.

# --- Persistent database (Neon, free) ---
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/asahi?sslmode=require

# --- Auth (required in production) ---
# JWT_SECRET=replace-with-a-long-random-string

# --- Email: set these to deliver the monthly document to a REAL inbox ---
# Without them, email still WORKS: the app sends via Ethereal (a free, no-signup
# test SMTP) and opens a preview URL where you can view the sent message. Set the
# SMTP_* values below to deliver to real recipients instead.
#
# Free option A — Brevo (https://www.brevo.com, 300 emails/day):
#   create an account → SMTP & API → generate an SMTP key
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@example.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=Asahi Payroll <no-reply@yourdomain.com>
#
# Free option B — Gmail (needs an App Password, not your login password):
#   Google Account → Security → 2-Step Verification → App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=you@gmail.com
#
# Free option C — Resend (https://resend.com, 3,000/mo · 100/day) via SMTP.
#   Dashboard → API Keys → create a key (this is the SMTP password; user is literally "resend").
#   NOTE: with no verified domain you may only send FROM onboarding@resend.dev and only TO
#   your own account email. To mail staff at arbitrary addresses, verify a domain (DNS records).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=Asahi Payroll <onboarding@resend.dev>

# PORT=4000
