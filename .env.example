# Copy this file to `.env` (in the project root). Everything here is OPTIONAL —
# with none of it set, the app runs the zero-setup in-memory demo.

# --- Persistent database (Neon, free) ---
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/asahi?sslmode=require

# --- Auth (required in production) ---
# JWT_SECRET=replace-with-a-long-random-string

# --- Email: set these to deliver the monthly document to a REAL inbox ---
# Without any of this, email still WORKS: the app sends via Ethereal (a free,
# no-signup test SMTP) and returns a preview URL where you can view the message.
#
# IMPORTANT on Render's free instances: outbound ports 25, 465 and 587 are
# blocked, so EVERY SMTP option below fails there with a connection timeout, no
# matter whose credentials you use. Port 443 is not blocked — use the HTTP API.
#
# Option A (works on Render free) — Resend over HTTPS, 3,000/mo:
#   https://resend.com → API Keys → create a key.
#   With no verified domain you may only send FROM onboarding@resend.dev and
#   only TO your own account email. Verify a domain to mail anyone else.
# RESEND_API_KEY=re_your_api_key
# SMTP_FROM=Asahi Payroll <onboarding@resend.dev>
#
# Option B (SMTP — fine locally or on a host that allows outbound 587):
#   Brevo (https://www.brevo.com, 300/day):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@example.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=Asahi Payroll <no-reply@yourdomain.com>
#
#   Gmail (needs an App Password, not your login password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=you@gmail.com

# PORT=4000
